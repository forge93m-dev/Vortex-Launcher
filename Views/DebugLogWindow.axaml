<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VortexLauncher.Views.DebugLogWindow" Title="Vortex Game Console &amp; Debug Logs" Width="900" Height="500" WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <Border Grid.Row="0" Background="Transparent" Padding="0,0,0,20">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="Eyebrow" Text="WORKSPACE / DIAGNOSTICS" />
                    <TextBlock Text="Session console" Foreground="{DynamicResource ThemeTextBrush}" FontWeight="SemiBold" FontSize="25" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="ExportReportButton" Classes="SecondaryBtn" Content="Save error report" Click="OnExportReportClick"/><Button Classes="SecondaryBtn" Content="Clear logs" Click="OnClearClick"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#0B0F12" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
            <ScrollViewer x:Name="LogScrollViewer">
                <ItemsControl x:Name="LogItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontFamily="Consolas, Cascadia Code, Courier New, monospace" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4"><TextBlock Classes="Muted" Text="Warnings do not always indicate a crash. Reports are saved locally, not sent automatically." FontSize="11"/><TextBlock x:Name="ReportStatus" Classes="Muted" TextWrapping="Wrap" FontSize="11"/></StackPanel>
    </Grid>
</Window>

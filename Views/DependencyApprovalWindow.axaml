<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VortexLauncher.Views.DependencyApprovalWindow" Title="Required dependencies" Width="580" Height="480" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ExtendClientAreaToDecorationsHint="True" Background="{DynamicResource ThemeBackgroundBrush}">
    <Border x:Name="dialogContent" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <TextBlock Text="Review dependencies" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Grid.Row="1" Text="These libraries and dependencies are needed by your selection. Allow the launcher to download and install them?" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSubtextBrush}" Margin="0,10,0,16" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="WorkspaceRow" Padding="12,14" Margin="0,0,4,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" />
                                    <TextBlock Text="{Binding Version.DisplayName}" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding RequiredBy, StringFormat='Required by: {0}'}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="3" Text="Cancel stops the whole installation. Optional dependencies are not added." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeSubtextBrush}" Margin="0,12,0,14" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Classes="SecondaryBtn" Content="Cancel installation" Click="OnCancel" />
                <Button x:Name="ApproveButton" Classes="PrimaryBtn" Content="Allow and install" Click="OnApprove" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

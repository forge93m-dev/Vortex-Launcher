<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:downloads="clr-namespace:VortexLauncher.Core.Management" x:Class="VortexLauncher.Views.DownloadsWindow" Title="Transfer center" Width="860" Height="590" MinWidth="600" MinHeight="400" Background="{DynamicResource ThemeBackgroundBrush}" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource ThemeSidebarBrush}" Padding="26,22" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="WORKSPACE / TRANSFERS" Classes="LibraryMetaLabel"/><TextBlock Text="Downloads &amp; tasks" FontSize="25" FontWeight="SemiBold"/></StackPanel><Border Grid.Column="1" Classes="Chip" VerticalAlignment="Center"><TextBlock Text="THIS SESSION"/></Border></Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="152,*" Margin="24">
            <StackPanel Spacing="14" Margin="0,6,22,0"><TextBlock Text="Your activity" Classes="SectionTitle"/><TextBlock Text="Game files, mods, imports and repairs appear here." Classes="Muted" FontSize="12"/><Border Height="1" Background="{DynamicResource ThemeBorderBrush}" Margin="0,6"/><TextBlock Text="Cancel safely" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Downloaded files are kept where supported. Completed tasks remain in this session's history." Classes="Muted" FontSize="11"/></StackPanel>
            <Panel Grid.Column="1">
                <TextBlock x:Name="emptyHint" Text="Nothing to download yet.&#10;Your next installation will appear here." Classes="Muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="tasks"><ItemsControl.ItemTemplate><DataTemplate x:DataType="downloads:DownloadOperation">
                    <Border Classes="WorkspaceRow" Padding="8,14" Margin="0,0,4,8">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center"/></Grid>
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Stage}" Classes="Muted" TextWrapping="Wrap" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Started}" Classes="Muted" FontSize="10" Margin="12,0,0,0"/></Grid>
                            <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" Maximum="100" Height="4"/>
                            <TextBlock Text="{Binding Details}" Classes="Muted" FontSize="11" TextWrapping="Wrap"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Classes="SecondaryBtn" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Panel>
        </Grid>
    </Grid>
</Window>

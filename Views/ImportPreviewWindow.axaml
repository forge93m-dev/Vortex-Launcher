<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VortexLauncher.Views.ImportPreviewWindow" Title="Import preview" Width="660" Height="590" MinWidth="520" MinHeight="470" WindowStartupLocation="CenterOwner" ExtendClientAreaToDecorationsHint="True" Background="{DynamicResource ThemeBackgroundBrush}">
    <Window.Styles>
        <Style Selector="Border.ImportCard">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.ImportChip">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
    </Window.Styles>
    <Border x:Name="dialogContent" Background="{DynamicResource ThemeBackgroundBrush}">
        <DockPanel Margin="28,22,28,22">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Classes="SecondaryBtn" Content="Cancel" Click="OnCancelClick" />
                <Button x:Name="ImportButton" Classes="PrimaryBtn" Content="Import instance" Click="OnImportClick" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="0,0,8,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="ImportCard" Width="56" Height="56" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="LogoLetter" Text="P" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="Eyebrow" Text="WORKSPACE / IMPORT" />
                            <TextBlock x:Name="PackName" Classes="PageTitle" FontSize="24" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <WrapPanel x:Name="Chips" />
                        </StackPanel>
                    </Grid>
                    <UniformGrid x:Name="Stats" Columns="4" />
                    <StackPanel x:Name="Rows" Spacing="8" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="DiskText" Classes="Muted" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="SizeText" Grid.Column="1" Classes="Muted" FontSize="12" Margin="12,0,0,0" />
                    </Grid>
                    <TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Existing instances are never overwritten. Nothing in the pack can reach outside its own instance folder." />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VortexLauncher.ViewModels" xmlns:conv="using:VortexLauncher.Converters" xmlns:views="using:VortexLauncher.Views" x:Class="VortexLauncher.Views.InstanceDetailsWindow" x:DataType="vm:InstanceDetailsViewModel" Title="Instance Manager" Opened="OnWindowOpened" Width="1080" Height="720" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterOwner" SystemDecorations="None" Background="{DynamicResource ThemeBackgroundBrush}">
    <Window.Resources>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.CaptionButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSubtextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.CaptionButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="Button.CaptionButton.CloseCaption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DC3554" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.DetailsShell">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SideButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSubtextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Button.SideButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeSidebarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="Button.SideButton.active"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
        <Style Selector="Button.SideButton.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="Border.ContentCard">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.ActionButton">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ThemeSidebarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.ActionButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.ActionButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSubtextBrush}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="ToggleSwitch.ModToggle">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <Border x:Name="detailsShell" Classes="DetailsShell" Opacity="1" RenderTransform="translate(0,0)" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid RowDefinitions="40,Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource ThemeSidebarBrush}" PointerPressed="OnCaptionPointerPressed">
                <Grid ColumnDefinitions="*,Auto" Margin="14,3,5,3">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="INSTANCE MANAGER" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.5" Foreground="{DynamicResource ThemeSubtextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="MinimizeCaption" Classes="CaptionButton" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                            <PathIcon Width="10" Height="10" Data="M0,4 L10,4 L10,5 L0,5 Z" />
                        </Button>
                        <Button x:Name="MaximizeCaption" Classes="CaptionButton" Click="OnMaximizeClick" ToolTip.Tip="Maximize / restore">
                            <PathIcon Width="10" Height="10" Data="M0,0 L10,0 L10,10 L0,10 Z M1,1 L1,9 L9,9 L9,1 Z" />
                        </Button>
                        <Button x:Name="CloseCaption" Classes="CaptionButton CloseCaption" Click="OnCloseClick" ToolTip.Tip="Close">
                            <PathIcon Width="10" Height="10" Data="M0,1 L1,0 L5,4 L9,0 L10,1 L6,5 L10,9 L9,10 L5,6 L1,10 L0,9 L4,5 Z" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource ThemeSidebarBrush}" Padding="24,16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="88,*,Auto">
                    <Border Width="68" Height="68" HorizontalAlignment="Left" CornerRadius="7" ClipToBounds="True" views:RoundedClip.IsEnabled="True"><Panel><views:WorldCover Seed="{Binding InstanceTitle}"/><conv:AsyncImage SourcePath="{Binding InstanceArtworkPath}" DecodeWidth="192" Stretch="UniformToFill"/></Panel></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" Margin="0,0,20,0"><TextBlock Text="INSTANCE WORKSPACE" Classes="LibraryMetaLabel"/><TextBlock Text="{Binding InstanceTitle}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InstanceTitle}"/><TextBlock Text="{Binding InstanceSubtitle}" Classes="Muted" FontSize="12"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="ActionButton" Content="Save error report" Command="{Binding SaveErrorReportCommand}"/><Button Classes="ActionButton" Content="Refresh" Command="{Binding RefreshCommand}" Padding="16,8"/></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="164,*,198">
                <Border Grid.Column="0" Background="Transparent" Padding="14,22">
                    <StackPanel>
                        <TextBlock Text="INSTANCE" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Classes="SideButton" Command="{Binding $parent[Window].DataContext.SelectSectionCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Grid x:Name="sectionContent" Grid.Column="1" RowDefinitions="Auto,*" Margin="22,18,16,18" DragDrop.AllowDrop="True" Background="{DynamicResource ThemeBackgroundBrush}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSection}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Manage files and content for this instance" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Items.Count, StringFormat='{}{0} items'}" Foreground="{DynamicResource ThemeSubtextBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsFileListSection}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ContentCard WorkspaceRow" MinHeight="68" Margin="0,0,4,6" Padding="12,14" Background="Transparent" BorderThickness="0,0,0,1" CornerRadius="4">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#50FA7B" IsVisible="{Binding IsEnabled}" Margin="3,0,10,0" />
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Version}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" Classes="ModToggle" IsVisible="{Binding IsMod}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Command="{Binding $parent[Window].DataContext.ToggleModCommand}" CommandParameter="{Binding}" OnContent="" OffContent="" />
                                            <Button Grid.Column="3" Classes="IconButton danger" Margin="6,0,0,0" ToolTip.Tip="Remove file" AutomationProperties.Name="Remove file"
                                                IsVisible="{Binding $parent[Window].DataContext.IsInstallableSection}" IsEnabled="{Binding $parent[Window].DataContext.CanRemoveFiles}"
                                                Command="{Binding $parent[Window].DataContext.RemoveItemCommand}" CommandParameter="{Binding}">
                                                <PathIcon Width="14" Height="14" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsServersSection}">
                        <Border Grid.Row="0" Classes="ContentCard" Padding="14" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding NewServerName}" Watermark="Server name" Background="{DynamicResource ThemeBackgroundBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" CornerRadius="7" Padding="9" />
                                <TextBox Grid.Column="1" Text="{Binding NewServerAddress}" Watermark="Address, e.g. play.example.com" Background="{DynamicResource ThemeBackgroundBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" CornerRadius="7" Padding="9" />
                                <Button Grid.Column="2" Classes="ActionButton" Content="Add server" Command="{Binding AddServerCommand}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ContentCard" Padding="14" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="◆" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DisplayAddress}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="12" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="ActionButton" Content="Join" Command="{Binding $parent[Window].DataContext.JoinServerCommand}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="3" Classes="ActionButton" Content="Copy" Command="{Binding $parent[Window].DataContext.CopyServerAddressCommand}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="4" Classes="ActionButton" Content="Remove" Command="{Binding $parent[Window].DataContext.RemoveServerCommand}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsScreenshotsSection}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ContentCard" Width="210" Height="170" Margin="0,0,12,12" Padding="8">
                                        <Grid RowDefinitions="*,Auto,Auto">
                                            <Border Grid.Row="0" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="7" ClipToBounds="True">
                                                <conv:AsyncImage SourcePath="{Binding Path}" DecodeWidth="544" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,8,2,5" />
                                            <Button Grid.Row="2" Classes="ActionButton" Content="Open image" Command="{Binding $parent[Window].DataContext.OpenItemCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="1" IsVisible="{Binding IsEmpty}" Margin="{Binding EmptyStateMargin}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Padding="24">
                        <StackPanel Spacing="14" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                <PathIcon Width="26" Height="26" Foreground="{DynamicResource AccentBrush}" Data="M2,4 L10,4 L13,7 L26,7 L26,23 L2,23 Z M4,9 L4,21 L24,21 L24,9 Z" />
                            </Border>
                            <TextBlock Text="{Binding EmptyTitle}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EmptyDescription}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding IsInstallableSection}">
                                <Button Classes="PrimaryBtn" Content="Browse content" Command="{Binding DownloadModsCommand}" />
                                <Button Classes="ActionButton" Content="Add files" Click="OnAddFilesClick" IsEnabled="{Binding CanImportFiles}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="dropHint" Grid.Row="1" IsVisible="False" IsHitTestVisible="False" CornerRadius="8" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Padding="24">
                        <StackPanel VerticalAlignment="Center" Spacing="12">
                            <TextBlock Text="Drop files to add them" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedSection}" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Original files stay untouched. Existing files are not overwritten." FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource ThemeSubtextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Column="2" Background="{DynamicResource ThemeSidebarBrush}" Padding="14,22,16,22" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,0,0,0">
                    <Grid RowDefinitions="*,Auto,Auto,Auto" HorizontalAlignment="Stretch">
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10">
                            <TextBlock Text="ACTIONS" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,6" />
                            <Button Classes="PrimaryBtn" Content="Browse content" Command="{Binding DownloadModsCommand}" HorizontalAlignment="Stretch" IsVisible="{Binding IsInstallableSection}" />
                            <Button Classes="ActionButton" Content="Manage mods" Command="{Binding ManageModsCommand}" IsVisible="{Binding IsModsSection}" IsEnabled="{Binding CanMaintain}" />
                            <Button Classes="ActionButton" Content="Preview mod updates" Command="{Binding UpdateAllModsCommand}" IsVisible="{Binding IsModsSection}" IsEnabled="{Binding CanMaintain}" />
                            <Button Classes="ActionButton" Content="Check compatibility" Command="{Binding CheckCompatibilityCommand}" IsVisible="{Binding IsModsSection}" />
                            <Button Classes="ActionButton" Content="Add files" Click="OnAddFilesClick" IsEnabled="{Binding CanImportFiles}" IsVisible="{Binding IsInstallableSection}" />
                            <TextBlock Text="INSTANCE TOOLS" Classes="Eyebrow" Margin="4,12,0,0" />
                            <Button Classes="ActionButton" Content="Update Vortex Client" Command="{Binding UpdateVortexClientCommand}" IsVisible="{Binding SupportsClientUpdate}" IsEnabled="{Binding CanMaintain}" />
                            <Button Classes="ActionButton" Content="Repair instance" Command="{Binding RepairInstanceCommand}" IsEnabled="{Binding CanMaintain}" />
                            <Button Classes="ActionButton" Content="Downloads" Click="OnDownloadsClick" />
                            <Button Classes="ActionButton" Content="Share pack…" Command="{Binding SharePackCommand}" IsEnabled="{Binding CanMaintain}"/>
                        </StackPanel></ScrollViewer>
                        <TextBlock Grid.Row="1" Text="{Binding StatusMessage, FallbackValue='Select an item to manage it'}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" MaxHeight="72" ToolTip.Tip="{Binding StatusMessage}" Margin="4,20,4,0" />
                        <Button Grid.Row="2" Classes="PrimaryBtn" Content="Undo removal" Command="{Binding UndoRemovalCommand}" IsVisible="{Binding HasUndoRemoval}" IsEnabled="{Binding CanUndoRemoval}" Margin="0,10,0,0"/>
                        <Button Grid.Row="3" Classes="ActionButton" Content="Open folder" Command="{Binding OpenSectionFolderCommand}" Margin="0,16,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VortexLauncher.ViewModels" x:Class="VortexLauncher.Views.InstanceModsWindow" x:DataType="vm:InstanceModsViewModel" x:Name="root" Title="Installed Mods" Width="680" Height="520" MinWidth="540" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemeBackgroundBrush}">
    <Border Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="0" Padding="28" BorderThickness="0">
        <Grid RowDefinitions="Auto, *, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="INSTANCE CONTENT" Classes="Eyebrow" />
                    <TextBlock Text="Installed mods" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="PrimaryBtn" Content="+  Add mods" Command="{Binding OpenDownloadModsCommand}" />
            </Grid>
            <Panel Grid.Row="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding InstalledMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ThemePanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" Command="{Binding #root.DataContext.ToggleModCommand}" CommandParameter="{Binding}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Classes="IconButton danger" ToolTip.Tip="Remove mod" AutomationProperties.Name="Remove mod" Command="{Binding #root.DataContext.RemoveModCommand}" CommandParameter="{Binding}" VerticalAlignment="Center">
                                            <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300" Spacing="12">
                    <TextBlock Classes="SectionTitle" Text="No mods yet" TextAlignment="Center" />
                    <TextBlock Classes="Muted" Text="Browse mods to customize this instance." TextAlignment="Center" />
                    <Button Classes="PrimaryBtn" Content="Browse mods" Command="{Binding OpenDownloadModsCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" Classes="Muted" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <Button Grid.Column="1" Content="Close" Click="OnCloseClick" Classes="SecondaryBtn" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>

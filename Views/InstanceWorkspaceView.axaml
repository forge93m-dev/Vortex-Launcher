<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:VortexLauncher.Views" xmlns:conv="using:VortexLauncher.Converters" x:Class="VortexLauncher.Views.InstanceWorkspaceView" x:Name="root">
  <Grid Margin="28,14,28,14" RowDefinitions="Auto,Auto,Auto,*">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <Button x:Name="BackToLibrary" Content="← Library" Click="OnBack" Classes="SecondaryBtn" VerticalAlignment="Center" Margin="0,0,20,0"/>
      <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0"><TextBlock Text="{Binding Instance.Name}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Instance.SummaryText}" Classes="Muted" FontSize="11"/></StackPanel>
      <Button Grid.Column="2" x:Name="WorkspacePlay" Classes="PlayButton LibraryPlay" Click="OnPlay" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinWidth="140"><TextBlock Text="{Binding Instance.LaunchButtonText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    </Grid>
    <Grid Grid.Row="1" Grid.RowSpan="3" ColumnDefinitions="168,*" Margin="0,2,0,0">
    <StackPanel x:Name="SectionTabs" Spacing="3" Margin="0,0,16,0">
      <Button Content="Overview" Tag="Overview" Click="OnTab" Classes="WorkspaceMode"/>
      <Button Content="Mods" Tag="Mods" Click="OnTab" Classes="WorkspaceMode"/>
      <Button Content="Resource packs" Tag="Resource packs" Click="OnTab" Classes="WorkspaceMode"/>
      <Button Content="Shaders" Tag="Shader packs" Click="OnTab" Classes="WorkspaceMode"/>
      <Button Content="Worlds" Tag="Worlds" Click="OnTab" Classes="WorkspaceMode"/>
      <Button Content="More files" Tag="More files" Click="OnTab" Classes="WorkspaceMode"/>
      <Button Content="Settings" Tag="Settings" Click="OnTab" Classes="WorkspaceMode"/>
    </StackPanel>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
    <Border Grid.Row="0" x:Name="BusyBanner" IsVisible="False" Classes="WorkspaceAside" Padding="10" Margin="0,0,0,10"><Grid ColumnDefinitions="Auto,*,Auto"><ProgressBar IsIndeterminate="True" Width="55" Height="3" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="BusyStatus" Classes="Muted" Margin="12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" x:Name="CancelWorkspaceOperation" Content="Cancel operation" Click="OnCancelOperation" Classes="SecondaryBtn"/></Grid></Border>
    <Grid Grid.Row="1" x:Name="WorkspaceBody">
      <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <Border CornerRadius="10" Height="126" ClipToBounds="True" views:RoundedClip.IsEnabled="True"><Panel><views:WorldCover Seed="{Binding Instance.Name}"/><conv:AsyncImage SourcePath="{Binding Instance.CoverImagePath}" DecodeWidth="1100" Stretch="UniformToFill"/><Border Background="#A0101316"/><StackPanel Margin="22" VerticalAlignment="Center" Spacing="6"><TextBlock Text="Ready for your next session" FontSize="23" Foreground="White"/><TextBlock Text="{Binding Instance.StatusText}" Foreground="#DDFFFFFF" FontSize="12"/></StackPanel></Panel></Border>
          <UniformGrid Columns="3">
            <Border Classes="WorkspaceAside" Padding="14" Margin="0,0,10,0"><StackPanel Spacing="6"><TextBlock Classes="Eyebrow" Text="LAUNCH"/><StackPanel x:Name="LaunchRows" Spacing="4"/></StackPanel></Border>
            <Border Classes="WorkspaceAside" Padding="14" Margin="0,0,10,0"><StackPanel Spacing="6"><TextBlock Classes="Eyebrow" Text="MODS"/><StackPanel x:Name="ModRows" Spacing="4"/></StackPanel></Border>
            <Border Classes="WorkspaceAside" Padding="14"><StackPanel Spacing="6"><TextBlock Classes="Eyebrow" Text="WORLDS"/><StackPanel x:Name="WorldRows" Spacing="4"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="Everything for this instance" FontSize="18" FontWeight="SemiBold"/>
          <Border Classes="WorkspaceAside" Padding="14" IsVisible="{Binding Details.SupportsClientUpdate}"><StackPanel Spacing="8"><TextBlock Text="Vortex Client" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Add Vortex features or update to the client bundled with this launcher. Close Minecraft first; your settings and other mods are kept." Classes="Muted" TextWrapping="Wrap"/><Button x:Name="OverviewClientButton" Content="{Binding Instance.VortexClientActionText}" Command="{Binding Details.UpdateVortexClientCommand}" IsEnabled="{Binding Details.CanMaintain}" Classes="PrimaryBtn" HorizontalAlignment="Left"/></StackPanel></Border>
          <WrapPanel>
            <Button Content="Manage mods →" Tag="Mods" Click="OnTab" Classes="SecondaryBtn" Margin="0,0,10,10"/>
            <Button Content="Add resource packs →" Tag="Resource packs" Click="OnTab" Classes="SecondaryBtn" Margin="0,0,10,10"/>
            <Button Content="Your worlds →" Tag="Worlds" Click="OnTab" Classes="SecondaryBtn" Margin="0,0,10,10"/>
            <Button Content="Instance settings →" Tag="Settings" Click="OnTab" Classes="SecondaryBtn" Margin="0,0,10,10"/>
          </WrapPanel>
          <TextBlock Text="Manage files and install content here without opening another manager. Your worlds and existing settings stay unchanged." Classes="Muted" TextWrapping="Wrap" MaxWidth="660" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>
      <views:InstalledModsView x:Name="ModsPage" IsVisible="False" DataContext="{Binding Mods}"/>
      <Grid x:Name="FilesPage" IsVisible="False" RowDefinitions="Auto,*">
        <ComboBox x:Name="ExtraSections" Width="220" HorizontalAlignment="Left" IsVisible="False" SelectionChanged="OnExtraSection" Margin="0,0,0,12"/>
        <views:InstanceFilesView Grid.Row="1" x:Name="Files" DataContext="{Binding Details}"/>
      </Grid>
      <ScrollViewer x:Name="SettingsPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="850" HorizontalAlignment="Left">
          <TextBlock Text="Instance settings &amp; tools" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Maintenance actions stay here, separate from everyday play and mod management." Classes="Muted" TextWrapping="Wrap"/>
          <Button x:Name="OpenLauncherSettings" Content="Game memory &amp; Java defaults →" Click="OnLauncherSettings" Classes="SecondaryBtn" HorizontalAlignment="Left"/>
          <ContentControl x:Name="LaunchSettingsHost"/>
          <Border Classes="WorkspaceAside" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Vortex Client" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Update the bundled client while keeping its HUD settings and other mods." Classes="Muted" TextWrapping="Wrap"/><Button Content="Update Vortex Client" Command="{Binding Details.UpdateVortexClientCommand}" IsEnabled="{Binding Details.CanMaintain}" IsVisible="{Binding Details.SupportsClientUpdate}" Classes="SecondaryBtn" HorizontalAlignment="Left"/></StackPanel></Border>
          <WrapPanel>
            <Button Content="Repair instance" Command="{Binding Details.RepairInstanceCommand}" IsEnabled="{Binding Details.CanMaintain}" Classes="SecondaryBtn" Margin="0,0,10,10"/>
            <Button Content="Share pack…" Command="{Binding Details.SharePackCommand}" IsEnabled="{Binding Details.CanMaintain}" Classes="SecondaryBtn" Margin="0,0,10,10"/>
            <Button Content="Save error report" Command="{Binding Details.SaveErrorReportCommand}" Classes="SecondaryBtn" Margin="0,0,10,10"/>
            <Button Content="Check mods" Command="{Binding Details.CheckCompatibilityCommand}" Classes="SecondaryBtn" Margin="0,0,10,10"/>
            <Button Content="Open instance folder" Click="OnFolder" Classes="SecondaryBtn" Margin="0,0,10,10"/>
          </WrapPanel>
          <TextBlock Text="{Binding Details.StatusMessage}" Classes="Muted" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="CatalogPage" IsVisible="False" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10"><Button x:Name="ReturnFromCatalog" Content="← Installed content" Click="OnInstalled" Classes="SecondaryBtn"/><TextBlock Grid.Column="1" Text="Choose content → review version → install" Classes="Muted" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/></Grid>
        <ContentControl Grid.Row="1" x:Name="CatalogHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </Grid>
    </Grid>
    </Grid>
  </Grid>
</UserControl>

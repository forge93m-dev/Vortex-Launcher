<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VortexLauncher.ViewModels" xmlns:models="using:VortexLauncher.Models" xmlns:views="using:VortexLauncher.Views" xmlns:conv="using:VortexLauncher.Converters" x:Class="VortexLauncher.Views.MainWindow" x:DataType="vm:MainWindowViewModel" x:Name="root" Opened="OnWindowOpened" Title="Vortex Launcher" Icon="/Assets/Branding/vortex-icon-v1.ico" Width="1280" Height="800" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="LibraryPlayBrush" Color="#D7F36A"/>
        <SolidColorBrush x:Key="LibraryPlayHoverBrush" Color="#E6FF91"/>
    </Window.Resources>
    <Window.Styles><StyleInclude Source="avares://Vortex Launcher/Styles/GameLibrary.axaml"/></Window.Styles>
    <Panel>
        <Border x:Name="mainShell" Classes="StartupShell" Background="{DynamicResource ThemeBackgroundBrush}">
            <Grid RowDefinitions="72,*,42">
                <Border x:Name="navigationRail" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,28,0">
                            <Image Source="/Assets/Branding/vortex-icon-v1.png" Width="32" Height="32" Stretch="Uniform"/>
                            <TextBlock Text="VORTEX" FontSize="17" FontWeight="Bold" LetterSpacing="2" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="libraryNav" Classes="LibraryNav" Classes.active="{Binding IsInstancesTab}" Command="{Binding SelectTabCommand}" CommandParameter="Instances" AutomationProperties.Name="Library">
                                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z" Width="15" Height="15"/><TextBlock Classes="NavLabel" Text="Library" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="modpacksNav" Classes="LibraryNav" Classes.active="{Binding IsModpacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Modpacks" AutomationProperties.Name="Modpacks">
                                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M12,2 L22,7 L12,12 L2,7 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17" Width="15" Height="15"/><TextBlock Classes="NavLabel" Text="Discover" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="profilesNav" Classes="LibraryNav" Classes.active="{Binding IsAccountsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Accounts" AutomationProperties.Name="Profiles">
                                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 L4,18 C4,13 20,13 20,18 L20,21 Z" Width="15" Height="15"/><TextBlock Classes="NavLabel" Text="Profiles" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="settingsNav" Classes="LibraryNav" Classes.active="{Binding IsSettingsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Settings" AutomationProperties.Name="Settings">
                                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M3,5 L21,5 L21,7 L3,7 Z M3,11 L21,11 L21,13 L3,13 Z M3,17 L21,17 L21,19 L3,19 Z M6,3 L9,3 L9,9 L6,9 Z M15,9 L18,9 L18,15 L15,15 Z M9,15 L12,15 L12,21 L9,21 Z" Width="15" Height="15"/><TextBlock Classes="NavLabel" Text="Settings" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="ProfileButton" Command="{Binding SelectTabCommand}" CommandParameter="Accounts" AutomationProperties.Name="Active player profile" Padding="0" VerticalAlignment="Center">
                            <Border x:Name="activePlayerCard" Height="40" Padding="7,4" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="30" Height="30" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"><TextBlock Text="{Binding ActiveAccount.Username[0]}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="105"><TextBlock Text="{Binding ActiveAccount.Username}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Active profile" Classes="Muted" FontSize="10" LineHeight="13"/></StackPanel>
                                    <TextBlock Text="⌄" Classes="Muted" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="28,22,28,18">
                    <Grid IsVisible="{Binding !IsInstancesTab}" Margin="0,0,0,20">
                        <StackPanel Spacing="5"><TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" LetterSpacing="-0.6"/><TextBlock Text="{Binding PageDescription}" Classes="Muted" FontSize="12"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14" IsVisible="{Binding CanCancelInstallation}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{Binding TransferDetails}" Classes="Muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,14,8"/>
                            <ProgressBar Grid.Row="1" Value="{Binding DownloadProgress}" Maximum="100" Height="4" Margin="0,0,14,0"/>
                            <Button Grid.Column="1" Grid.RowSpan="2" Content="Cancel" Command="{Binding CancelInstallationCommand}" Classes="SecondaryBtn"/>
                        </Grid>
                    </Border>
                    <Panel Grid.Row="2">
                        <Grid x:Name="instancesPage" Classes="PagePanel" RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsInstancesTab}">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="Library" FontSize="27" FontWeight="SemiBold" LetterSpacing="-0.8"/><TextBlock Text="{Binding Library.CountLabel}" Classes="Muted" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><Button Classes="SecondaryBtn" Content="Import pack" Click="OnImportPackClick" IsEnabled="{Binding !IsInitializing}"/><Button Classes="PrimaryBtn" Content="+  New instance" Click="OnAddInstanceClick" IsEnabled="{Binding !IsInitializing}"/></StackPanel>
                            </Grid>
                            <Border Grid.Row="1" IsVisible="{Binding HasInterruptedOperations}" Background="{DynamicResource ThemePanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <ScrollViewer MaxHeight="96"><ItemsControl ItemsSource="{Binding InterruptedOperations}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Grid.Column="1" Classes="SecondaryBtn" Content="Folder" Command="{Binding #root.DataContext.OpenInterruptedFolderCommand}" CommandParameter="{Binding}" Margin="4,0"/>
                                        <Button Grid.Column="2" Classes="SecondaryBtn" Content="Cancel (keep files)" IsEnabled="{Binding CanCancel}" Command="{Binding #root.DataContext.CancelInterruptedCommand}" CommandParameter="{Binding}" Margin="4,0"/>
                                        <Button Grid.Column="3" Classes="PrimaryBtn" Content="Resume" IsEnabled="{Binding CanResume}" Command="{Binding #root.DataContext.ResumeInterruptedCommand}" CommandParameter="{Binding}" Margin="4,0"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                            </Border>
                            <Grid Grid.Row="2" ColumnDefinitions="252,24,*">
                                <Grid x:Name="libraryCollection" RowDefinitions="Auto,Auto,*">
                                    <TextBox x:Name="librarySearch" Text="{Binding Library.SearchQuery, Mode=TwoWay}" Watermark="Search your library" Margin="0,0,0,12" AutomationProperties.Name="Search instances"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,12">
                                        <Button x:Name="allInstancesFilter" Classes="LibraryFilter" Classes.active="{Binding Library.IsAllSelected}" Content="All games" Command="{Binding Library.ShowAllCommand}"/>
                                        <Button x:Name="favoritesFilter" Classes="LibraryFilter" Classes.active="{Binding Library.FavoritesOnly}" Content="★  Favorites" Command="{Binding Library.ShowFavoritesCommand}"/>
                                    </StackPanel>
                                    <Panel Grid.Row="2">
                                        <ListBox x:Name="instanceCards" Classes="LibraryList" ItemsSource="{Binding Library.VisibleInstances}" SelectedItem="{Binding Library.SelectedInstance, Mode=TwoWay}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Installed instances">
                                            <ListBox.ItemTemplate><DataTemplate DataType="models:InstanceModel">
                                                <Border Classes="InstanceCard LibraryRow" Height="88" Padding="7" PointerPressed="OnInstanceCardPointerPressed" Opacity="{Binding CardOpacity}">
                                                    <Grid ColumnDefinitions="64,*,24">
                                                        <Border CornerRadius="5" ClipToBounds="True" views:RoundedClip.IsEnabled="True" Margin="0,0,10,0">
                                                            <Panel>
                                                                <views:WorldCover Seed="{Binding Name}"/>
                                                                <conv:AsyncImage SourcePath="{Binding CoverImagePath}" DecodeWidth="160" Stretch="UniformToFill"/>
                                                                <Border Background="#20000000"/>
                                                                <Border Width="26" Height="26" CornerRadius="5" Background="#99131518" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" IsVisible="{Binding HasIcon}" ClipToBounds="True"><conv:AsyncImage SourcePath="{Binding IconPath}" DecodeWidth="64" Stretch="UniformToFill"/></Border>
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                            <TextBlock Text="{Binding SummaryText}" Classes="Muted" FontSize="10" LineHeight="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding StatusText}" Classes="Muted" FontSize="10" LineHeight="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7">
                                                            <Button Classes="IconButton" Content="···" FontSize="17" Width="24" Height="26" Padding="0" Click="OnOpenInstanceMenuClick" Tag="{Binding}" ToolTip.Tip="Instance actions" AutomationProperties.Name="Instance actions"/>
                                                            <TextBlock Text="★" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsFavorite}" HorizontalAlignment="Center" FontSize="11"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="Loading library…" IsVisible="{Binding IsInitializing}" Classes="Muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nothing here yet." Classes="Muted" IsVisible="{Binding Library.IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24"/>
                                    </Panel>
                                </Grid>
                                <Panel Grid.Column="2">
                                    <ContentControl x:Name="librarySelection" Content="{Binding Library.SelectedInstance}" IsVisible="{Binding Library.HasSelection}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <ContentControl.ContentTemplate><DataTemplate DataType="models:InstanceModel">
                                            <Grid RowDefinitions="*,Auto,Auto">
                                                <Border x:Name="libraryHero" CornerRadius="10" ClipToBounds="True" views:RoundedClip.IsEnabled="True" MinHeight="150">
                                                    <Panel>
                                                        <views:WorldCover Seed="{Binding Name}"/>
                                                        <conv:AsyncImage SourcePath="{Binding CoverImagePath}" DecodeWidth="1600" Stretch="UniformToFill"/>
                                                        <Border><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="70%,100%"><GradientStop Offset="0" Color="#14101316"/><GradientStop Offset="0.6" Color="#55101316"/><GradientStop Offset="1" Color="#EE101316"/></LinearGradientBrush></Border.Background></Border>
                                                        <Grid Margin="26" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="MINECRAFT  /  JAVA EDITION" Foreground="#E6EFEB" FontSize="10" FontWeight="SemiBold" LetterSpacing="2" VerticalAlignment="Top"/>
                                                            <Button Grid.Column="1" Classes="HeroFavorite" Content="{Binding FavoriteSymbol}" Command="{Binding #root.DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}" ToolTip.Tip="Pin / unpin favorite" AutomationProperties.Name="Toggle favorite"/>
                                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="32" FontWeight="Bold" LetterSpacing="-0.9" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="82" ToolTip.Tip="{Binding Name}"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Background="#660D1518" CornerRadius="4" Padding="8,4"><TextBlock Foreground="#E5EEEA" FontSize="10" Text="{Binding Version}"/></Border>
                                                                    <Border Background="#660D1518" CornerRadius="4" Padding="8,4"><TextBlock Foreground="#E5EEEA" FontSize="10" Text="{Binding Loader}"/></Border>
                                                                    <Border Background="#D7F36A" CornerRadius="4" Padding="8,4" IsVisible="{Binding VortexClientEnabled}"><TextBlock Foreground="#18200B" FontSize="10" Text="VORTEX CLIENT" FontWeight="SemiBold"/></Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Panel>
                                                </Border>
                                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0">
                                                    <Button x:Name="featuredPlayButton" Classes="PlayButton LibraryPlay" Command="{Binding #root.DataContext.LaunchSpecificInstanceCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanLaunch}" AutomationProperties.Name="Play selected instance">
                                                        <StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Width="13" Height="13" Data="M4,2 L21,12 L4,22 Z"/><TextBlock Text="{Binding LaunchButtonText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                    <StackPanel Grid.Column="1" Spacing="3" Margin="16,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlayTimeText}" Classes="Muted" FontSize="10" LineHeight="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Classes="SecondaryBtn" Content="Manage" Click="OnManageInstanceClick" Tag="{Binding}" AutomationProperties.Name="Manage selected instance"/>
                                                        <Button Classes="IconButton" Content="···" FontSize="20" Click="OnOpenInstanceMenuClick" Tag="{Binding}" ToolTip.Tip="Instance actions" AutomationProperties.Name="Selected instance actions"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,2">
                                                    <Grid ColumnDefinitions="*,*,Auto">
                                                        <StackPanel Spacing="5"><TextBlock Text="MINECRAFT" Classes="LibraryMetaLabel"/><TextBlock Text="{Binding Version}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="MOD LOADER" Classes="LibraryMetaLabel"/><TextBlock Text="{Binding Loader}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                        <Button Grid.Column="2" Classes="LibraryTextButton" Click="OnSetCoverClick" VerticalAlignment="Center" AutomationProperties.Name="Change selected cover">
                                                            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Change cover" FontSize="11" VerticalAlignment="Center"/><PathIcon Width="11" Height="11" Data="M5,2 L20,2 L20,17 L18,17 L18,6 L4,20 L2,18 L16,4 L5,4 Z"/></StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate></ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <Border IsVisible="{Binding !Library.HasSelection}" CornerRadius="10" ClipToBounds="True" views:RoundedClip.IsEnabled="True">
                                        <Panel>
                                            <views:WorldCover Seed="A new world"/>
                                            <Border Background="#C9101316"/>
                                            <StackPanel x:Name="libraryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24" Spacing="14">
                                                <TextBlock Text="MAKE ROOM FOR ADVENTURE" Foreground="#D7F36A" FontSize="10" LetterSpacing="2" TextWrapping="Wrap" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Library.EmptyTitle}" FontSize="28" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Library.EmptyDescription}" Foreground="#BBC8C2" FontSize="12" LineHeight="19" TextWrapping="Wrap" TextAlignment="Center"/>
                                                <Button Content="Clear filters" Command="{Binding Library.ClearFiltersCommand}" Classes="SecondaryBtn" IsVisible="{Binding Library.HasInstances}" HorizontalAlignment="Center"/>
                                                <Button Content="+  Create your first instance" Click="OnAddInstanceClick" Classes="PrimaryBtn" IsVisible="{Binding !Library.HasInstances}" IsEnabled="{Binding !IsInitializing}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Grid>
                        <Grid x:Name="modpacksPage" Classes="PagePanel" RowDefinitions="*" IsVisible="{Binding IsModpacksTab}">
                            <Grid Grid.Row="0" x:Name="modpacksContentGrid" DataContext="{Binding ModpacksVm}" RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,16" IsEnabled="{Binding !IsInstalling}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBox Grid.Column="0" Text="{Binding SearchQuery}" Watermark="Search modpacks..." Background="{DynamicResource ThemePanelBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" />
                                        <Button Grid.Column="1" Classes="PrimaryBtn" Content="Search" Command="{Binding SearchModpacksCommand}" Margin="10,0,0,0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*,Auto">
                                        <StackPanel Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Category" FontSize="12" Foreground="{DynamicResource ThemeSubtextBrush}" />
                                            <ComboBox x:Name="ModpackCategoryFilter" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxDropDownHeight="280">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Loader" FontSize="11" Foreground="{DynamicResource ThemeSubtextBrush}" />
                                            <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxDropDownHeight="280">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Sort by" FontSize="11" Foreground="{DynamicResource ThemeSubtextBrush}" />
                                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxDropDownHeight="280">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="SecondaryBtn" Content="Reset" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" IsVisible="{Binding IsSearching}" IsIndeterminate="True" Width="70" Height="3" Margin="10,0" />
                                        <Button Grid.Column="2" Content="Load more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" IsEnabled="{Binding !IsSearching}" />
                                    </Grid>
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*, 300">
                                    <ScrollViewer Grid.Column="0" Margin="0,0,16,0" HorizontalScrollBarVisibility="Disabled">
                                        <ListBox ItemsSource="{Binding Modpacks}" SelectedItem="{Binding SelectedModpack}" Background="Transparent" BorderThickness="0" Padding="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="VortexCard" Padding="14" CornerRadius="14">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <Image Source="{Binding IconBitmap}" Width="48" Height="48" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" FontSize="15" />
                                                                <TextBlock Text="{Binding Item.Description}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" TextWrapping="Wrap" MaxLines="2" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                    <Border Grid.Column="1" Classes="VortexCard" Padding="20">
                                        <Panel>
                                            <TextBlock Text="Select a modpack from the list to view details and install" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding SelectedModpack, Converter={x:Static ObjectConverters.IsNull}}" />
                                            <ContentControl Content="{Binding SelectedModpack}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate DataType="vm:ModrinthModItemViewModel">
                                                        <Grid RowDefinitions="*,Auto">
                                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                                                                <StackPanel Spacing="16">
                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0" Background="{DynamicResource ThemeSidebarBrush}" ClipToBounds="True">
                                                                            <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Item.Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Item.Title}"/>
                                                                            <TextBlock Text="{Binding Item.Author, StringFormat='by {0}'}" Classes="Muted" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="Choose a version" Classes="FieldLabel"/>
                                                                        <ComboBox ItemsSource="{Binding DataContext.ModpacksVm.ModpackVersions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            SelectedItem="{Binding DataContext.ModpacksVm.SelectedVersion, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                            IsEnabled="{Binding !DataContext.ModpacksVm.IsLoadingVersions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            MaxDropDownHeight="280" HorizontalAlignment="Stretch" AutomationProperties.Name="Modpack version">
                                                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                                                        <TextBlock Text="{Binding Item.Description}" Classes="Muted" FontSize="12"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                            <Button Grid.Row="1" Classes="PrimaryBtn" Content="Install modpack"
                                                                Command="{Binding DataContext.ModpacksVm.InstallSelectedModpackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                IsEnabled="{Binding !DataContext.ModpacksVm.IsInstalling, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </Panel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Grid x:Name="accountsPage" Classes="PagePanel" ColumnDefinitions="280,*" IsVisible="{Binding IsAccountsTab}">
                            <Border Classes="VortexCard" Padding="24" Margin="0,0,20,0" VerticalAlignment="Top">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="Eyebrow" Text="NEW PROFILE" />
                                    <TextBlock Classes="SectionTitle" Text="Make yourself at home" TextWrapping="Wrap" />
                                    <TextBlock Classes="Muted" Text="Add a local player profile for your Minecraft instances." />
                                    <StackPanel Spacing="6" Margin="0,8,0,0">
                                        <TextBlock Classes="FieldLabel" Text="Player name" />
                                        <TextBox Text="{Binding NewAccountUsername}" Watermark="Minecraft username" AutomationProperties.Name="Player name" />
                                    </StackPanel>
                                    <Button Classes="PrimaryBtn" Content="+  Add profile" Command="{Binding AddAccountCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="VortexCard" Padding="24">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Margin="0,0,0,20" Spacing="6">
                                        <TextBlock Classes="SectionTitle" Text="Your profiles" />
                                        <TextBlock Classes="Muted" Text="Select a profile to use it for your next launch." />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Accounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ThemeSidebarBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding Username[0]}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="Muted" Text="Local player profile" FontSize="11" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <Button Classes="SecondaryBtn" Content="Use profile" Command="{Binding #root.DataContext.SelectAccountCommand}" CommandParameter="{Binding}" />
                                                                <Button Classes="IconButton danger" Command="{Binding #root.DataContext.DeleteAccountCommand}" CommandParameter="{Binding}" ToolTip.Tip="Delete profile" AutomationProperties.Name="Delete profile">
                                                                    <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid x:Name="settingsPage" Classes="PagePanel" RowDefinitions="*,Auto" IsVisible="{Binding IsSettingsTab}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                                    <StackPanel Spacing="18" Margin="0,0,9,0">
                                        <Border Classes="VortexCard" Padding="24">
                                            <StackPanel Spacing="14">
                                                <TextBlock Classes="Eyebrow" Text="APPEARANCE" />
                                                <TextBlock Classes="SectionTitle" Text="Choose your atmosphere" />
                                                <TextBlock Classes="Muted" Text="Every screen follows your palette. Pick a theme or fine-tune the accent." />
                                                <ItemsControl ItemsSource="{Binding ThemePresets}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Classes="SecondaryBtn" Click="OnThemePresetClick" Margin="3" HorizontalContentAlignment="Stretch" Padding="12,10">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Brush}" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="FieldLabel" Text="Accent color" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Text="{Binding AccentColor}" Watermark="#7AA2F7" Margin="0,0,10,0" />
                                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="VortexCard" Padding="24">
                                            <StackPanel Spacing="12">
                                                <TextBlock Classes="Eyebrow" Text="GAME BEHAVIOR" />
                                                <TextBlock Classes="SectionTitle" Text="Stay out of the way" />
                                                <ToggleSwitch Content="Minimize while playing" IsChecked="{Binding MinimizeOnGameLaunch}" />
                                                <TextBlock Classes="Muted" Text="The launcher returns automatically when you exit Minecraft." FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="18" Margin="9,0,0,0">
                                        <Border Classes="VortexCard" Padding="24">
                                            <StackPanel Spacing="12">
                                                <TextBlock Classes="Eyebrow" Text="LAUNCHER UPDATES" />
                                                <TextBlock Classes="SectionTitle" Text="{Binding LauncherVersionLabel}" TextWrapping="Wrap" />
                                                <TextBlock Classes="Muted" Text="{Binding LauncherUpdateStatus}" />
                                                <TextBlock Classes="Muted" Text="{Binding LastLauncherUpdateResult}" FontSize="11" />
                                                <TextBlock Text="{Binding LauncherUpdateNotes}" TextWrapping="Wrap" IsVisible="{Binding UpdateAvailable}" />
                                                <TextBlock Classes="Muted" Text="{Binding UpdateSource}" FontSize="10" TextWrapping="Wrap" />
                                                <StackPanel Spacing="8">
                                                    <Button x:Name="CheckLauncherUpdatesButton" Content="Check for updates" Command="{Binding CheckLauncherUpdatesCommand}" Classes="SecondaryBtn" IsEnabled="{Binding !IsCheckingUpdates}" />
                                                    <Button x:Name="InstallLauncherUpdateButton" Content="Install update" Command="{Binding InstallLauncherUpdateCommand}" Classes="PrimaryBtn" IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !IsInstallingUpdate}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="VortexCard" Padding="24">
                                            <StackPanel Spacing="12">
                                                <TextBlock Classes="Eyebrow" Text="PERFORMANCE" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="SectionTitle" Text="Memory allocation" />
                                                    <Border Grid.Column="1" Classes="Chip" Background="{DynamicResource AccentSoftBrush}">
                                                        <TextBlock Text="{Binding RamGb, StringFormat='{}{0} GB'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Classes="Muted" Text="Give your instance room to breathe. Large modpacks may need more memory." />
                                                <Slider Minimum="2" Maximum="16" Value="{Binding RamGb}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="Muted" Text="2 GB" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Classes="Muted" Text="16 GB" FontSize="11" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="VortexCard" Padding="24">
                                            <StackPanel Spacing="12">
                                                <TextBlock Classes="Eyebrow" Text="ADVANCED" />
                                                <TextBlock Classes="SectionTitle" Text="Java runtime" />
                                                <TextBlock Classes="Muted" Text="Leave the path empty to use automatic Java detection." FontSize="12" />
                                                <TextBlock Classes="FieldLabel" Text="Java executable" />
                                                <TextBox Text="{Binding CustomJavaPath}" Watermark="Automatic detection" />
                                                <TextBlock Classes="FieldLabel" Text="JVM arguments" Margin="0,8,0,0" />
                                                <TextBox Text="{Binding JvmArgs}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />
                                                <TextBlock Classes="Muted" Text="Only change these arguments if you know what they do." FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="Muted" Text="Your preferences, your launcher." VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="PrimaryBtn" Content="Save settings" Command="{Binding SaveSettingsCommand}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Panel>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource ThemeSidebarBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button x:Name="downloadCenterButton" Classes="LibraryTextButton" Command="{Binding ShowDownloadsCommand}" AutomationProperties.Name="Downloads" Padding="4,0" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Width="14" Height="14" Data="M12,2 L12,15 M6,9 L12,15 L18,9 M3,16 L3,21 L21,21 L21,16"/><TextBlock Text="Downloads" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="Muted" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip.Tip="{Binding StatusMessage}"/>
                        <Button Grid.Column="2" Content="Install update" Command="{Binding InstallLauncherUpdateCommand}" Classes="LibraryTextButton" IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !IsInstallingUpdate}" Margin="0,0,16,0" Padding="6,0" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="VORTEX LAUNCHER" FontSize="9" LetterSpacing="1.5" Foreground="{DynamicResource ThemeSubtextBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Background="#BB080B12" IsVisible="{Binding IsGlobalLoading}">
            <Border Classes="VortexCard" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Classes="Eyebrow" Text="WORKING ON IT" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LoadingTitle}" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="Muted" TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="{Binding !CanCancelInstallation}" Value="{Binding DownloadProgress}" Maximum="100" Height="5" Margin="0,8" />
                    <TextBlock Text="{Binding TransferDetails}" Classes="Muted" FontSize="12" TextAlignment="Center" />
                    <Button Content="Cancel installation" Command="{Binding CancelInstallationCommand}" Classes="SecondaryBtn" IsVisible="{Binding CanCancelInstallation}" HorizontalAlignment="Center" />
                    <Button Content="View downloads" Command="{Binding ShowDownloadsCommand}" Classes="SecondaryBtn" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="startupOverlay" Classes="StartupOverlay" Background="{DynamicResource ThemeBackgroundBrush}" IsVisible="{Binding IsStartupGreetingVisible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Classes="Eyebrow" Text="VORTEX LAUNCHER" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="{Binding StartupGreeting}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StartupUsername}" Foreground="{DynamicResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" />
                <TextBlock Text="Preparing your next adventure..." Classes="Muted" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Panel>
</Window>

<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VortexLauncher.ViewModels" xmlns:models="using:VortexLauncher.Models" xmlns:views="using:VortexLauncher.Views" xmlns:conv="using:VortexLauncher.Converters" x:Class="VortexLauncher.Views.MainWindow" x:DataType="vm:MainWindowViewModel" x:Name="root" Opened="OnWindowOpened" Title="Vortex Launcher" Icon="/Assets/Branding/vortex-icon-v1.ico" Width="1280" Height="800" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeBackgroundBrush}">
    <Window.Resources>
        <conv:IndexEqualsConverter x:Key="IndexEquals"/>
    </Window.Resources>

    <Panel>
        <Border x:Name="mainShell" Classes="StartupShell" Background="{DynamicResource ThemeBackgroundBrush}">
            <Grid ColumnDefinitions="88,*" RowDefinitions="*,42">
                <Border x:Name="navigationRail" Background="{DynamicResource ThemeBackgroundBrush}" Padding="0,16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Image Source="/Assets/Branding/vortex-icon-v1.png" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,20" ToolTip.Tip="Vortex Launcher"/>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <Button x:Name="libraryNav" Classes="LibraryNav" Classes.active="{Binding IsInstancesTab}" Command="{Binding SelectTabCommand}" CommandParameter="Instances" AutomationProperties.Name="Library">
                                <StackPanel Spacing="6"><PathIcon Classes="Line" Data="M8,5.5 L8,18.5 Q8,19.9 9.2,19.2 L19.6,12.9 Q20.8,12 19.6,11.1 L9.2,4.8 Q8,4.1 8,5.5 Z" Width="22" Height="22" HorizontalAlignment="Center"/><TextBlock Classes="NavLabel" Text="Play" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="modpacksNav" Classes="LibraryNav" Classes.active="{Binding IsModpacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Modpacks" AutomationProperties.Name="Modpacks">
                                <StackPanel Spacing="6"><PathIcon Classes="Line" Data="M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M15.5,8.5 L13.5,13.5 L8.5,15.5 L10.5,10.5 Z" Width="22" Height="22" HorizontalAlignment="Center"/><TextBlock Classes="NavLabel" Text="Discover" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="profilesNav" Classes="LibraryNav" Classes.active="{Binding IsAccountsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Accounts" AutomationProperties.Name="Profiles">
                                <StackPanel Spacing="6"><PathIcon Classes="Line" Data="M12,4.7 A3.8,3.8 0 1 0 12,12.3 A3.8,3.8 0 1 0 12,4.7 Z M4.5,20 C5.9,16.4 8.7,14.5 12,14.5 C15.3,14.5 18.1,16.4 19.5,20" Width="22" Height="22" HorizontalAlignment="Center"/><TextBlock Classes="NavLabel" Text="Profiles" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button x:Name="wardrobeNav" Classes="LibraryNav" Click="OnOpenWardrobeClick" AutomationProperties.Name="Wardrobe" IsEnabled="{Binding !IsInitializing}">
                                <StackPanel Spacing="6"><PathIcon Classes="Line" Data="M9,4 C9.6,5.3 10.7,6 12,6 C13.3,6 14.4,5.3 15,4 L19.5,6.2 L17.9,10.2 L15.9,9.4 L15.9,20 L8.1,20 L8.1,9.4 L6.1,10.2 L4.5,6.2 Z" Width="22" Height="22" HorizontalAlignment="Center"/><TextBlock Text="Wardrobe" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Button x:Name="settingsNav" Grid.Row="2" Classes="LibraryNav" Classes.active="{Binding IsSettingsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Settings" AutomationProperties.Name="Settings">
                            <StackPanel Spacing="6"><PathIcon Classes="Line" Data="M4,7 L14,7 M18,7 L20,7 M4,17 L8,17 M12,17 L20,17 M16,5 A2,2 0 1 0 16,9 A2,2 0 1 0 16,5 Z M10,15 A2,2 0 1 0 10,19 A2,2 0 1 0 10,15 Z" Width="22" Height="22" HorizontalAlignment="Center"/><TextBlock Classes="NavLabel" Text="Settings" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Grid x:Name="LibraryAndPages" Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="8,16,20,8">
                    <Grid IsVisible="{Binding !IsInstancesTab}" Margin="0,0,0,20">
                        <StackPanel Spacing="5"><TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" LetterSpacing="-0.6"/><TextBlock Text="{Binding PageDescription}" Classes="Muted" FontSize="12"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14" IsVisible="{Binding CanCancelInstallation}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{Binding TransferDetails}" Classes="Muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,14,8"/>
                            <ProgressBar Grid.Row="1" Value="{Binding DownloadProgress}" Maximum="100" Height="4" Margin="0,0,14,0"/>
                            <Button Grid.Column="1" Grid.RowSpan="2" Content="Cancel" Command="{Binding CancelInstallationCommand}" Classes="SecondaryBtn"/>
                        </Grid>
                    </Border>
                    <Panel Grid.Row="2">
                        <Grid x:Name="instancesPage" Classes="PagePanel" views:SurfaceMotion.Kind="Page" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsInstancesTab}">
                            <Border Grid.Row="0" IsVisible="{Binding HasInterruptedOperations}" Background="{DynamicResource ThemePanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <ScrollViewer MaxHeight="96"><ItemsControl ItemsSource="{Binding InterruptedOperations}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Grid.Column="1" Classes="SecondaryBtn" Content="Folder" Command="{Binding #root.DataContext.OpenInterruptedFolderCommand}" CommandParameter="{Binding}" Margin="4,0"/>
                                        <Button Grid.Column="2" Classes="SecondaryBtn" Content="Cancel (keep files)" IsEnabled="{Binding CanCancel}" Command="{Binding #root.DataContext.CancelInterruptedCommand}" CommandParameter="{Binding}" Margin="4,0"/>
                                        <Button Grid.Column="3" Classes="PrimaryBtn" Content="Resume" IsEnabled="{Binding CanResume}" Command="{Binding #root.DataContext.ResumeInterruptedCommand}" CommandParameter="{Binding}" Margin="4,0"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                            </Border>
                            <Panel Grid.Row="1">
                                <ContentControl x:Name="librarySelection" Content="{Binding Library.SelectedInstance}" IsVisible="{Binding Library.HasSelection}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <ContentControl.ContentTemplate><DataTemplate DataType="models:InstanceModel">
                                        <Panel x:Name="hubHero">
                                            <Border x:Name="heroCover" CornerRadius="28" ClipToBounds="True" views:RoundedClip.IsEnabled="True">
                                                <Panel><views:WorldCover Seed="{Binding Name}"/><conv:AsyncImage SourcePath="{Binding DisplayCoverPath}" DecodeWidth="1600" Stretch="UniformToFill"/></Panel>
                                            </Border>
                                            <Border x:Name="selectedInstanceBar" Background="{DynamicResource ThemeGlassBrush}" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="24" Padding="26,22" Margin="28" MaxWidth="540" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                <StackPanel Spacing="8">
                                                    <WrapPanel>
                                                        <Border Classes="Chip HubStatus" Margin="0,0,8,0"><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/></Border>
                                                        <Border Classes="Chip"><TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"/></Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="34" FontWeight="ExtraBold" LetterSpacing="-0.6" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button Classes="HubChip" Content="Favorite" Command="{Binding #root.DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Toggle favorite" Margin="0,0,8,8"/>
                                                        <Button Classes="HubChip" Content="Open instance" Click="OnManageInstanceClick" Tag="{Binding}" AutomationProperties.Name="Manage selected instance" Margin="0,0,8,8"/>
                                                        <Button Classes="HubChip" Content="Mods" CommandParameter="Mods" Tag="{Binding}" Click="OnWorkspaceShortcut" Margin="0,0,8,8"/>
                                                        <Button Classes="HubChip" Content="Worlds" CommandParameter="Worlds" Tag="{Binding}" Click="OnWorkspaceShortcut" Margin="0,0,8,8"/>
                                                        <Button Classes="HubChip" Content="Resource packs" CommandParameter="Resource packs" Tag="{Binding}" Click="OnWorkspaceShortcut" Margin="0,0,8,8"/>
                                                        <Button Classes="HubChip" Content="Settings" CommandParameter="Settings" Tag="{Binding}" Click="OnWorkspaceShortcut" Margin="0,0,8,8"/>
                                                        <Button Classes="HubChip" Content="Change cover" Click="OnSetCoverClick" AutomationProperties.Name="Change selected cover" Margin="0,0,8,8"/>
                                                        <Button x:Name="featuredClientButton" Classes="HubChip HubAccentChip" Content="{Binding VortexClientActionText}" Command="{Binding #root.DataContext.UpdateVortexClientCommand}" CommandParameter="{Binding}" IsVisible="{Binding SupportsVortexClient}" IsEnabled="{Binding CanChangeFiles}" Margin="0,0,8,8" ToolTip.Tip="Your HUD settings and other mods are kept."/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                    </DataTemplate></ContentControl.ContentTemplate>
                                </ContentControl>
                                <!-- The full collection opens over the cover from the instance switcher,
                                     and stays open while nothing can be featured (empty library or no matches). -->
                                <Border x:Name="libraryBrowser" Background="{DynamicResource ThemeBackgroundBrush}" KeyDown="OnLibraryBrowserKeyDown">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding ElementName="instanceSwitcher" Path="IsChecked"/>
                                            <Binding Path="Library.HasSelection" Converter="{x:Static BoolConverters.Not}"/>
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <Grid RowDefinitions="Auto,Auto,*">
                                        <Grid x:Name="browserHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="All instances" FontSize="25" FontWeight="SemiBold" LetterSpacing="-0.8"/><TextBlock Text="{Binding Library.CountLabel}" Classes="Muted" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><Button Classes="SecondaryBtn" Content="Import pack" Click="OnImportPackClick" IsEnabled="{Binding !IsInitializing}"/><Button Classes="PrimaryBtn" Content="+  New instance" Click="OnAddInstanceClick" IsEnabled="{Binding !IsInitializing}"/></StackPanel>
                                        </Grid>
                                        <Grid x:Name="browserFilters" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                            <TextBox x:Name="librarySearch" Text="{Binding Library.SearchQuery, Mode=TwoWay}" Watermark="Search by name, version or loader…" Width="430" HorizontalAlignment="Left" Margin="0,0,24,0" AutomationProperties.Name="Search instances"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button x:Name="allInstancesFilter" Classes="LibraryFilter" Classes.active="{Binding Library.IsAllSelected}" Content="All instances" Command="{Binding Library.ShowAllCommand}"/>
                                                <Button x:Name="favoritesFilter" Classes="LibraryFilter" Classes.active="{Binding Library.FavoritesOnly}" Content="★  Favorites" Command="{Binding Library.ShowFavoritesCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                <Panel Grid.Row="2">
                                    <views:InstanceTileGrid x:Name="instanceCards" ItemsSource="{Binding Library.VisibleInstances}" SelectedItem="{Binding Library.SelectedInstance, Mode=TwoWay}" AutomationProperties.Name="Installed instances">
                                        <views:InstanceTileGrid.ItemTemplate><DataTemplate DataType="models:InstanceModel">
                                            <Border Classes="InstanceCard LibraryTile" Height="156" Padding="14" PointerPressed="OnInstanceCardPointerPressed" Tapped="OnInstanceTileTapped" Opacity="{Binding CardOpacity}">
                                                <Grid RowDefinitions="*,Auto">
                                                    <Grid ColumnDefinitions="60,*,24">
                                                        <Border Classes="InstanceThumbnail" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14" ClipToBounds="True" views:RoundedClip.IsEnabled="True">
                                                            <Panel><views:WorldCover Seed="{Binding Name}"/><conv:AsyncImage SourcePath="{Binding DisplayCoverPath}" DecodeWidth="128" Stretch="UniformToFill"/>
                                                                <Border Width="20" Height="20" CornerRadius="4" Background="#CC131518" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="3" IsVisible="{Binding HasIcon}" ClipToBounds="True"><conv:AsyncImage SourcePath="{Binding IconPath}" DecodeWidth="48" Stretch="UniformToFill"/></Border>
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                            <TextBlock Text="{Binding SummaryText}" Classes="Muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding StatusText}" Classes="Muted" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="4">
                                                            <Button Classes="IconButton" Width="24" Height="24" Padding="0" Click="OnOpenInstanceMenuClick" Tag="{Binding}" ToolTip.Tip="More actions" AutomationProperties.Name="Instance actions"><PathIcon Width="16" Height="4" Data="M4,10 A2,2 0 1 0 4,14 A2,2 0 1 0 4,10 Z M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 Z M20,10 A2,2 0 1 0 20,14 A2,2 0 1 0 20,10 Z"/></Button>
                                                            <TextBlock Text="★" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsFavorite}" HorizontalAlignment="Center" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                                        <Button Classes="LibraryTextButton" Content="Manage" Click="OnManageInstanceClick" Tag="{Binding}" HorizontalAlignment="Left" AutomationProperties.Name="Manage instance"/>
                                                        <Button Grid.Column="1" Classes="PrimaryBtn TilePlay" Content="Play" Command="{Binding #root.DataContext.LaunchSpecificInstanceCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanLaunch}" Width="84" Padding="0" AutomationProperties.Name="Play instance"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></views:InstanceTileGrid.ItemTemplate>
                                    </views:InstanceTileGrid>
                                    <TextBlock Text="Loading library…" IsVisible="{Binding IsInitializing}" Classes="Muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border IsVisible="{Binding !Library.HasSelection}" Background="{DynamicResource ThemeSidebarBrush}" CornerRadius="12" Margin="0,0,14,0">
                                        <StackPanel x:Name="libraryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24" Spacing="14">
                                            <TextBlock Text="{Binding Library.EmptyTitle}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Library.EmptyDescription}" Classes="Muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <Button Content="Clear filters" Command="{Binding Library.ClearFiltersCommand}" Classes="SecondaryBtn" IsVisible="{Binding Library.HasInstances}" HorizontalAlignment="Center"/>
                                            <Button Content="+  Create your first instance" Click="OnAddInstanceClick" Classes="PrimaryBtn" IsVisible="{Binding !Library.HasInstances}" IsEnabled="{Binding !IsInitializing}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                                    </Grid>
                                </Border>
                            </Panel>
                            <Border x:Name="playBar" Grid.Row="2" Height="96" Margin="0,14,0,0" Padding="16,0" CornerRadius="28" Background="{DynamicResource ThemeSidebarBrush}">
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <ToggleButton x:Name="instanceSwitcher" Classes="HubSwitcher" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="320" AutomationProperties.Name="Choose instance" ToolTip.Tip="Show all instances">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="44" Height="44" CornerRadius="14" ClipToBounds="True" views:RoundedClip.IsEnabled="True" Margin="0,0,12,0">
                                                <Panel><views:WorldCover Seed="{Binding Library.SelectedInstance.Name, FallbackValue=Vortex}"/><conv:AsyncImage SourcePath="{Binding Library.SelectedInstance.DisplayCoverPath, FallbackValue=''}" DecodeWidth="128" Stretch="UniformToFill"/></Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Library.SelectedInstance.Name, FallbackValue='Choose an instance'}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Library.CountLabel, StringFormat='Switch instance · {0}'}" Classes="Muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <PathIcon Grid.Column="2" Classes="Line" Width="18" Height="18" Margin="10,0,4,0" VerticalAlignment="Center" Data="M7,10 L12,15 L17,10"/>
                                        </Grid>
                                    </ToggleButton>
                                    <Panel Grid.Column="1" Margin="16,0">
                                        <!-- Swells and fades behind PLAY when it is pressed. -->
                                        <Border x:Name="playPulse" Width="280" Height="62" CornerRadius="31" Background="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border>
                                        <Button x:Name="featuredPlayButton" Classes="LibraryPlay HubPlay" Click="OnFeaturedPlayClick" Command="{Binding LaunchSpecificInstanceCommand}" CommandParameter="{Binding Library.SelectedInstance}" IsEnabled="{Binding Library.SelectedInstance.CanLaunch, FallbackValue=False}" AutomationProperties.Name="Play selected instance">
                                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"><PathIcon Width="20" Height="20" VerticalAlignment="Center" Data="M8,5.5 L8,18.5 Q8,19.9 9.2,19.2 L19.6,12.9 Q20.8,12 19.6,11.1 L9.2,4.8 Q8,4.1 8,5.5 Z"/><TextBlock Text="PLAY" FontWeight="ExtraBold" VerticalAlignment="Center"/></StackPanel>
                                        </Button>
                                    </Panel>
                                    <Button x:Name="profileSwitcher" Grid.Column="2" Classes="ProfileButton" IsEnabled="{Binding !IsInitializing}" AutomationProperties.Name="Active player profile" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button.Flyout>
                                            <Flyout Placement="TopEdgeAlignedRight">
                                                <StackPanel Width="280" Spacing="10">
                                                    <TextBlock Text="Switch player" FontSize="17" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Recently used first · next launch only" Classes="Muted" FontSize="11"/>
                                                    <ScrollViewer MaxHeight="290" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:AccountModel">
                                                            <Button Classes="SecondaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,5" Click="OnQuickProfileClick" CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Username}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsActive}" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"/></Grid>
                                                            </Button>
                                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                    </ScrollViewer>
                                                    <TextBlock Text="{Binding ProfileError}" IsVisible="{Binding HasProfileError}" TextWrapping="Wrap" FontSize="11"/>
                                                    <Button Classes="PrimaryBtn" Content="Manage player names" HorizontalAlignment="Stretch" Click="OnManageProfilesClick"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border x:Name="activePlayerCard" Height="52" Padding="8,4" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <StackPanel VerticalAlignment="Center" MaxWidth="150"><TextBlock Text="{Binding ActiveAccount.Username}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/><TextBlock Text="Active player · change" Classes="Muted" FontSize="11" HorizontalAlignment="Right"/></StackPanel>
                                                <Border Width="44" Height="44" Background="{DynamicResource AccentSoftBrush}" CornerRadius="22"><TextBlock Text="{Binding ActiveAccount.Username[0]}" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid x:Name="modpacksPage" Classes="PagePanel" views:SurfaceMotion.Kind="Page" RowDefinitions="*" IsVisible="{Binding IsModpacksTab}">
                            <Grid Grid.Row="0" x:Name="modpacksContentGrid" DataContext="{Binding ModpacksVm}" RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,16" IsEnabled="{Binding !IsInstalling}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBox Grid.Column="0" Text="{Binding SearchQuery}" Watermark="Search modpacks..." Background="{DynamicResource ThemePanelBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" />
                                        <Button Grid.Column="1" Classes="PrimaryBtn" Content="Search" Command="{Binding SearchModpacksCommand}" Margin="10,0,0,0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*,Auto">
                                        <StackPanel Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Category" FontSize="12" Foreground="{DynamicResource ThemeSubtextBrush}" />
                                            <ComboBox x:Name="ModpackCategoryFilter" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxDropDownHeight="280">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Loader" FontSize="11" Foreground="{DynamicResource ThemeSubtextBrush}" />
                                            <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxDropDownHeight="280">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Sort by" FontSize="11" Foreground="{DynamicResource ThemeSubtextBrush}" />
                                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxDropDownHeight="280">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="SecondaryBtn" Content="Reset" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" IsVisible="{Binding IsSearching}" IsIndeterminate="True" Width="70" Height="3" Margin="10,0" />
                                        <Button Grid.Column="2" Content="Load more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" IsEnabled="{Binding !IsSearching}" />
                                    </Grid>
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*, 316">
                                    <ScrollViewer Grid.Column="0" Margin="0,0,16,0" HorizontalScrollBarVisibility="Disabled">
                                        <ListBox ItemsSource="{Binding Modpacks}" SelectedItem="{Binding SelectedModpack}" Background="Transparent" BorderThickness="0" Padding="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="WorkspaceRow" Padding="{DynamicResource RowPaddingTall}" Margin="0,0,0,4">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource ThemeBorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <Image Source="{Binding IconBitmap}" Width="68" Height="68" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}" FontSize="15" />
                                                                <TextBlock Text="{Binding Item.Description}" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="11" TextWrapping="Wrap" MaxLines="2" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                    <Border Grid.Column="1" Classes="WorkspaceAside" Padding="20">
                                        <Panel>
                                            <TextBlock Text="Select a modpack from the list to view details and install" Foreground="{DynamicResource ThemeSubtextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding SelectedModpack, Converter={x:Static ObjectConverters.IsNull}}" />
                                            <ContentControl Content="{Binding SelectedModpack}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate DataType="vm:ModrinthModItemViewModel">
                                                        <Grid RowDefinitions="*,Auto" views:SurfaceMotion.Kind="Content">
                                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                                                                <StackPanel Spacing="16">
                                                                    <StackPanel Spacing="14">
                                                                        <Border Height="112" CornerRadius="7" ClipToBounds="True" views:RoundedClip.IsEnabled="True"><Panel><views:WorldCover Seed="{Binding Item.Title}"/><Border Background="#33000000"/><Image Source="{Binding IconBitmap}" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Panel></Border>
                                                                        <TextBlock Text="MODPACK DETAILS" Classes="LibraryMetaLabel"/>
                                                                        <TextBlock Text="{Binding Item.Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Item.Title}"/>
                                                                        <TextBlock Text="{Binding Item.Author, StringFormat='by {0}'}" Classes="Muted" FontSize="11"/>
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="Choose a version" Classes="FieldLabel"/>
                                                                        <ComboBox ItemsSource="{Binding DataContext.ModpacksVm.ModpackVersions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            SelectedItem="{Binding DataContext.ModpacksVm.SelectedVersion, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                            IsEnabled="{Binding !DataContext.ModpacksVm.IsLoadingVersions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            MaxDropDownHeight="280" HorizontalAlignment="Stretch" AutomationProperties.Name="Modpack version">
                                                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                                                        <TextBlock Text="{Binding Item.Description}" Classes="Muted" FontSize="12"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                            <Button Grid.Row="1" Classes="PrimaryBtn" Content="Install modpack"
                                                                Command="{Binding DataContext.ModpacksVm.InstallSelectedModpackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                IsEnabled="{Binding !DataContext.ModpacksVm.IsInstalling, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </Panel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Grid x:Name="accountsPage" Classes="PagePanel" views:SurfaceMotion.Kind="Page" RowDefinitions="Auto,*" IsVisible="{Binding IsAccountsTab}">
                            <Border Classes="IdentityBanner" Padding="16" Margin="0,0,0,16">
                                <Grid ColumnDefinitions="68,*,Auto">
                                    <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="{Binding ActiveAccount.Username[0]}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="CURRENT PLAYER" Classes="LibraryMetaLabel"/><TextBlock Text="{Binding ActiveAccount.Username}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Used for your next Minecraft session" Classes="Muted" FontSize="12"/></StackPanel>
                                    <Border Grid.Column="2" Classes="Chip" VerticalAlignment="Center"><TextBlock Text="{Binding ActiveAccount.KindChip}"/></Border>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" ColumnDefinitions="*,280">
                                <Grid RowDefinitions="Auto,*" Margin="0,0,26,0">
                                    <TextBlock Text="Saved players" Classes="SectionTitle" Margin="0,0,0,16"/>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Classes="WorkspaceRow" Padding="{DynamicResource RowPaddingTall}" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="52,*,Auto">
                                                <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemePanelBrush}"><TextBlock Text="{Binding Username[0]}" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding KindLabel}" Classes="Muted" FontSize="11"/><TextBlock Text="Active · next launch" IsVisible="{Binding IsActive}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Classes="SecondaryBtn" Content="Use profile" Command="{Binding #root.DataContext.SelectAccountCommand}" CommandParameter="{Binding}"/>
                                                    <Button Classes="IconButton" IsVisible="{Binding !IsMicrosoft}" Content="✎" Command="{Binding #root.DataContext.EditAccountCommand}" CommandParameter="{Binding}" ToolTip.Tip="Edit player name" AutomationProperties.Name="Edit player name"/>
                                                    <Button Classes="IconButton danger" Command="{Binding #root.DataContext.DeleteAccountCommand}" CommandParameter="{Binding}" ToolTip.Tip="Delete profile" AutomationProperties.Name="Delete profile"><PathIcon Data="M6,7 L18,7 L18,21 L6,21 Z M5,3 L9,3 L10,1 L14,1 L15,3 L19,3 L19,5 L5,5 Z" Width="13" Height="13"/></Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                </Grid>
                                <Border Grid.Column="1" Classes="WorkspaceAside" Padding="14" VerticalAlignment="Stretch">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14">
                                        <StackPanel Spacing="10" IsVisible="{Binding !IsEditingAccount}"><TextBlock Text="ADD A LOCAL PLAYER" Classes="LibraryMetaLabel"/><TextBlock Text="New profile" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Player name" Classes="FieldLabel"/><TextBox Text="{Binding NewAccountUsername}" Watermark="Minecraft username" AutomationProperties.Name="Player name"/><Button Classes="PrimaryBtn" Content="+  Add profile" Command="{Binding AddAccountCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsInitializing}"/></StackPanel>
                                        <Expander x:Name="microsoftAccountExpander" Header="Microsoft account" HorizontalAlignment="Stretch" IsVisible="{Binding !IsEditingAccount}"><StackPanel Spacing="9">
                                            <TextBlock Text="{Binding MicrosoftHelp}" Classes="Muted" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBox x:Name="microsoftClientIdBox" Text="{Binding MicrosoftClientId}" Watermark="Application (client) ID" AutomationProperties.Name="Azure application client ID"/>
                                            <Button x:Name="microsoftSignInButton" Classes="PrimaryBtn" Content="Sign in with Microsoft" Command="{Binding SignInMicrosoftCommand}" IsEnabled="{Binding CanStartMicrosoftSignIn}"/>
                                            <Border x:Name="microsoftCodeCard" IsVisible="{Binding HasMicrosoftCode}" Classes="WorkspaceRow" Padding="12"><StackPanel Spacing="6">
                                                <TextBlock Text="Enter this code on the Microsoft page" Classes="Muted" FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding MicrosoftCode}" FontSize="26" FontWeight="Bold" LetterSpacing="3"/>
                                                <Button Classes="SecondaryBtn" Content="Open Microsoft page" Command="{Binding OpenMicrosoftPageCommand}"/>
                                            </StackPanel></Border>
                                            <Button Classes="SecondaryBtn" Content="Cancel sign-in" Command="{Binding CancelMicrosoftSignInCommand}" IsVisible="{Binding IsMicrosoftBusy}"/>
                                            <TextBlock Text="{Binding MicrosoftStatus}" Classes="Muted" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel></Expander>
                                        <Expander x:Name="vortexAccountExpander" Header="Vortex account" HorizontalAlignment="Stretch" IsVisible="{Binding !IsEditingAccount}"><StackPanel Spacing="9">
                                        <StackPanel Spacing="9" IsEnabled="{Binding !IsVortexAccountBusy}">
                                            <TextBlock Text="VORTEX ACCOUNT" Classes="LibraryMetaLabel"/>
                                            <TextBlock Text="{Binding VortexAccountLabel}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Spacing="8" IsVisible="{Binding !HasVortexAccount}">
                                                <TextBox Text="{Binding VortexLogin}" Watermark="Vortex login" AutomationProperties.Name="Vortex login"/>
                                                <TextBox Text="{Binding VortexNickname}" Watermark="Vortex nickname" IsVisible="{Binding IsVortexRegistration}" AutomationProperties.Name="Vortex registration nickname"/>
                                                <TextBlock Text="Beta: use a unique password of 15+ characters and save it safely. Password recovery is not available yet." IsVisible="{Binding IsVortexRegistration}" Classes="Muted" FontSize="11" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding VortexPassword}" PasswordChar="●" Watermark="Password" AutomationProperties.Name="Vortex password"/>
                                                <TextBox Text="{Binding VortexPasswordConfirmation}" PasswordChar="●" Watermark="Repeat password" IsVisible="{Binding IsVortexRegistration}" AutomationProperties.Name="Repeat Vortex password"/>
                                                <CheckBox Content="Remember sign-in" IsChecked="{Binding RememberVortexAccount}" IsEnabled="{Binding CanRememberVortexAccount}"/>
                                                <Button Classes="PrimaryBtn" Content="{Binding VortexAuthAction}" Command="{Binding AuthenticateVortexCommand}" HorizontalAlignment="Stretch"/>
                                                <Button Classes="SecondaryBtn" Content="Sign in / Create account" Command="{Binding ToggleVortexRegistrationCommand}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8" IsVisible="{Binding HasVortexAccount}">
                                                <TextBox Text="{Binding VortexNickname}" Watermark="Vortex nickname" AutomationProperties.Name="Vortex nickname"/>
                                                <Button Classes="SecondaryBtn" Content="Save Vortex nickname" Command="{Binding RenameVortexNicknameCommand}" HorizontalAlignment="Stretch"/>
                                                <Button Classes="PrimaryBtn" Content="Use nickname for Minecraft" Command="{Binding UseVortexNicknameCommand}" HorizontalAlignment="Stretch"/>
                                                <Button Classes="SecondaryBtn" Content="Sign out" Command="{Binding SignOutVortexCommand}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding VortexAccountMessage}" Classes="Muted" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="Vortex accounts do not replace Microsoft accounts or verify ownership of an offline Minecraft name." Classes="Muted" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel></Expander>
                                        <Border Height="1" Background="{DynamicResource ThemeBorderBrush}" IsVisible="{Binding !IsEditingAccount}"/>
                                        <StackPanel Spacing="8" IsVisible="{Binding IsEditingAccount}">
                                            <TextBlock Text="Edit player name" FontSize="19" FontWeight="SemiBold"/>
                                            <TextBox x:Name="profileNameInput" Text="{Binding EditedAccountUsername}" AutomationProperties.Name="New player name"/>
                                            <TextBlock Text="A new offline name means a new player identity. Saves stay untouched." Classes="Muted" FontSize="11" TextWrapping="Wrap"/>
                                            <Grid ColumnDefinitions="*,8,*">
                                                <Button Content="Save name" Classes="PrimaryBtn" Command="{Binding SaveAccountNameCommand}" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="2" Content="Cancel" Classes="SecondaryBtn" Command="{Binding CancelEditAccountCommand}" HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="10" IsVisible="{Binding HasPendingProfileDeletion}">
                                            <TextBlock Text="Remove saved player?" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PendingDeleteAccount.Username}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Only the launcher profile is removed. Worlds and game files stay untouched." Classes="Muted" FontSize="12" TextWrapping="Wrap"/>
                                            <Button Content="Remove profile" Classes="SecondaryBtn danger" Command="{Binding ConfirmDeleteAccountCommand}" HorizontalAlignment="Stretch"/>
                                            <Button Content="Keep profile" Classes="SecondaryBtn" Command="{Binding CancelDeleteAccountCommand}" HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProfileError}" IsVisible="{Binding HasProfileError}" TextWrapping="Wrap" FontSize="12"/>
                                    </StackPanel></ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                        <Grid x:Name="settingsPage" Classes="PagePanel" views:SurfaceMotion.Kind="Page" RowDefinitions="*,Auto" IsVisible="{Binding IsSettingsTab}">
                            <Grid ColumnDefinitions="158,*">
<TabControl x:Name="SettingsTabs" Classes="WorkspaceTabs" TabStripPlacement="Left" Padding="0" BorderThickness="0">
<TabItem Header="Appearance"/>
<TabItem Header="Game &amp; memory"/>
<TabItem Header="Java"/>
<TabItem Header="Updates"/>
</TabControl>
<Panel Grid.Column="1" x:Name="settingsContent">
<ScrollViewer x:Name="settingsAppearance" views:SurfaceMotion.Kind="Section" IsVisible="{Binding #SettingsTabs.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=0}" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="22" Margin="28,4,8,20">
                                        <Border Classes="WorkspaceSection" Padding="0">
                                            <StackPanel Spacing="14">
                                                
                                                <TextBlock Classes="SectionTitle" Text="Appearance" />
                                                <TextBlock Classes="Muted" Text="Every screen follows your palette. Pick an accent, a palette and how dense lists should be." />
                                                <TextBlock Classes="FieldLabel" Text="Accent color" />
                                                <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Classes="AccentSwatch" Click="OnAccentSwatchClick" Width="30" Height="30" MinHeight="30" Padding="0" Margin="0,0,8,8" CornerRadius="15" BorderThickness="2" BorderBrush="Transparent" Background="{Binding}" ToolTip.Tip="{Binding}" AutomationProperties.Name="Accent color" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Text="{Binding AccentColor}" Watermark="#A78BFA" Margin="0,0,10,0" />
                                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}" />
                                                </Grid>
                                                <TextBlock Classes="FieldLabel" Text="Palette and background" />
                                                <ItemsControl ItemsSource="{Binding ThemePresets}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Classes="SecondaryBtn" Click="OnThemePresetClick" Margin="3" HorizontalContentAlignment="Stretch" Padding="12,10">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Brush}" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="FieldLabel" Text="List density" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="densityComfortable" Content="Comfortable" Tag="Comfortable" Click="OnDensityClick" Classes="SecondaryBtn" Classes.active="{Binding IsComfortableDensity}" />
                                                    <Button x:Name="densityCompact" Content="Compact" Tag="Compact" Click="OnDensityClick" Classes="SecondaryBtn" Classes.active="{Binding IsCompactDensity}" />
                                                </StackPanel>
                                                <TextBlock Classes="Muted" FontSize="12" Text="Compact fits more mods, files and search results on screen." />
                                                <TextBlock Classes="FieldLabel" Text="Preview" />
                                                <Border x:Name="appearancePreview" Classes="WorkspaceAside" Padding="14" HorizontalAlignment="Left" Width="330" IsHitTestVisible="False">
                                                    <StackPanel Spacing="8">
                                                        <Border Height="64" CornerRadius="10" ClipToBounds="True"><views:WorldCover Seed="Survival" /></Border>
                                                        <TextBlock Text="Survival" FontWeight="SemiBold" FontSize="16" />
                                                        <TextBlock Classes="Muted" Text="26.3 · Fabric · ready to play" FontSize="12" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Classes="PrimaryBtn" Content="Play" Focusable="False" />
                                                            <Button Classes="SecondaryBtn" Content="Mods" Focusable="False" />
                                                        </StackPanel>
                                                        <ProgressBar Value="62" Height="5" Foreground="{DynamicResource AccentBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="WorkspaceSection" Padding="0,20,0,0"><StackPanel Spacing="8"><TextBlock Text="Motion &amp; transitions" Classes="SectionTitle"/><ToggleSwitch Content="Interface animations" IsChecked="{Binding InterfaceAnimationsEnabled}" AutomationProperties.Name="Interface animations"/><TextBlock Classes="Muted" Text="Subtle page, preview and dialog fades. No sliding panels or flashing content. Disable entrances if you prefer less motion." FontSize="12"/></StackPanel></Border>
                                        <Border Classes="WorkspaceSection" Padding="0,20,0,0"><StackPanel Spacing="8"><TextBlock Text="Discord" Classes="SectionTitle"/><ToggleSwitch Content="Share launcher activity" IsChecked="{Binding DiscordPresenceEnabled}" AutomationProperties.Name="Share launcher activity"/><ToggleSwitch Content="Receive server invitations" IsChecked="{Binding ReceiveDiscordInvites}" AutomationProperties.Name="Receive server invitations"/><TextBlock Text="{Binding DiscordPresenceStatus}" Classes="Muted"/><TextBlock Classes="Muted" Text="Show your current launcher section in Discord. Server invitations require activity sharing and your confirmation before launching. Keep Minecraft closed to receive them here. No nicknames, instance names or server addresses are shared by the launcher status. Save settings to remember your choice." FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
                                    </StackPanel></ScrollViewer>
<ScrollViewer x:Name="settingsGame" views:SurfaceMotion.Kind="Section" IsVisible="{Binding #SettingsTabs.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=1}" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="24" Margin="28,4,8,20"><Border Classes="WorkspaceSection" Padding="0">
                                            <StackPanel Spacing="12">
                                                
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="SectionTitle" Text="Memory allocation" />
                                                    <Border Grid.Column="1" Classes="Chip" Background="{DynamicResource AccentSoftBrush}">
                                                        <TextBlock Text="{Binding RamGb, StringFormat='{}{0} GB'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Classes="Muted" Text="Give your instance room to breathe. Large modpacks may need more memory." />
                                                <Slider Minimum="2" Maximum="16" Value="{Binding RamGb}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="Muted" Text="2 GB" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Classes="Muted" Text="16 GB" FontSize="11" />
                                                </Grid>
                                            </StackPanel>
                                        </Border><Border Classes="WorkspaceSection" Padding="0,20,0,0">
                                            <StackPanel Spacing="12">
                                                
                                                <TextBlock Classes="SectionTitle" Text="Game behavior" />
                                                <ToggleSwitch Content="Minimize while playing" IsChecked="{Binding MinimizeOnGameLaunch}" />
                                                <TextBlock Classes="Muted" Text="The launcher returns automatically when you exit Minecraft." FontSize="12" />
                                            </StackPanel>
                                        </Border><Border Classes="WorkspaceSection" Padding="0,20,0,0"><StackPanel Spacing="12">
                                            <TextBlock Classes="SectionTitle" Text="Launcher library"/>
                                            <TextBlock x:Name="LibraryLocationHint" Classes="Muted" Text="On Windows, instances, profiles, settings and caches stay beside Vortex Launcher.exe. A new installation folder starts with a separate, empty library. Old folders are never connected or moved automatically." TextWrapping="Wrap"/>
                                            <WrapPanel><Button Content="Open data folder" Click="OnOpenDataFolder" Classes="SecondaryBtn" Margin="0,0,8,8"/></WrapPanel>
                                        </StackPanel></Border></StackPanel></ScrollViewer>
<ScrollViewer x:Name="settingsJava" views:SurfaceMotion.Kind="Section" IsVisible="{Binding #SettingsTabs.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=2}" HorizontalScrollBarVisibility="Disabled"><Border Margin="28,4,8,20">
                                            <StackPanel Spacing="12">
                                                
                                                <TextBlock Classes="SectionTitle" Text="Java &amp; launch arguments" />
                                                <TextBlock Classes="Muted" Text="Leave the path empty to use automatic Java detection." FontSize="12" />
                                                <TextBlock Classes="FieldLabel" Text="Java executable" />
                                                <TextBox Text="{Binding CustomJavaPath}" Watermark="Automatic detection" />
                                                <TextBlock Classes="FieldLabel" Text="JVM arguments" Margin="0,8,0,0" />
                                                <TextBox Text="{Binding JvmArgs}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" VerticalContentAlignment="Top" />
                                                <TextBlock Classes="Muted" Text="Only change these arguments if you know what they do." FontSize="12" />
                                                <TextBlock Classes="SectionTitle" Text="CurseForge" Margin="0,14,0,0" />
                                                <TextBlock Classes="Muted" Text="Needed to import CurseForge packs. Get a free key at console.curseforge.com; it stays on this computer." FontSize="12" TextWrapping="Wrap" />
                                                <TextBox x:Name="curseForgeKeyBox" Text="{Binding CurseForgeApiKey}" PasswordChar="•" Watermark="CurseForge API key (optional)" />
                                            </StackPanel>
                                        </Border></ScrollViewer>
<ScrollViewer x:Name="settingsUpdates" views:SurfaceMotion.Kind="Section" IsVisible="{Binding #SettingsTabs.SelectedIndex, Converter={StaticResource IndexEquals}, ConverterParameter=3}" HorizontalScrollBarVisibility="Disabled"><Border Margin="28,4,8,20">
                                            <StackPanel Spacing="12">
                                                
                                                <TextBlock Classes="SectionTitle" Text="{Binding LauncherVersionLabel}" TextWrapping="Wrap" />
                                                <TextBlock Classes="Muted" Text="{Binding LauncherUpdateStatus}" />
                                                <TextBlock Classes="Muted" Text="{Binding LastLauncherUpdateResult}" FontSize="11" />
                                                <TextBlock Text="{Binding LauncherUpdateNotes}" TextWrapping="Wrap" IsVisible="{Binding UpdateAvailable}" />
                                                <TextBlock Classes="Muted" Text="{Binding UpdateSource}" FontSize="10" TextWrapping="Wrap" />
                                                <StackPanel Spacing="8">
                                                    <Button x:Name="CheckLauncherUpdatesButton" Content="Check for updates" Command="{Binding CheckLauncherUpdatesCommand}" Classes="SecondaryBtn" IsEnabled="{Binding !IsCheckingUpdates}" />
                                                    <Button x:Name="InstallLauncherUpdateButton" Content="Install update" Command="{Binding InstallLauncherUpdateCommand}" Classes="PrimaryBtn" IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !IsInstallingUpdate}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border></ScrollViewer>
</Panel>
</Grid>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="Muted" Text="Your preferences are kept when the launcher updates." VerticalAlignment="Center"/><Button Grid.Column="1" Classes="PrimaryBtn" Content="Save settings" Command="{Binding SaveSettingsCommand}"/></Grid></Border>
                        </Grid>
                    </Panel>
                </Grid>
                <ContentControl x:Name="InstanceWorkspaceHost" Grid.Column="1" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource ThemeBackgroundBrush}" Padding="24,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button x:Name="downloadCenterButton" Classes="LibraryTextButton" Command="{Binding ShowDownloadsCommand}" AutomationProperties.Name="Downloads" Height="28" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><PathIcon Classes="Line" Width="16" Height="16" VerticalAlignment="Center" Data="M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20"/><TextBlock Text="Downloads" FontSize="11" LineHeight="14" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="Muted" FontSize="10" LineHeight="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip.Tip="{Binding StatusMessage}"/>
                        <Button Grid.Column="2" Content="Install update" Command="{Binding InstallLauncherUpdateCommand}" Classes="LibraryTextButton" IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !IsInstallingUpdate}" Margin="0,0,16,0" Padding="6,0" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="VORTEX LAUNCHER" FontSize="9" LetterSpacing="1.5" Foreground="{DynamicResource ThemeSubtextBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Background="#BB080B12" IsVisible="{Binding IsGlobalLoading}">
            <Border Classes="VortexCard" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Classes="Eyebrow" Text="WORKING ON IT" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LoadingTitle}" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="Muted" TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="{Binding !CanCancelInstallation}" Value="{Binding DownloadProgress}" Maximum="100" Height="5" Margin="0,8" />
                    <TextBlock Text="{Binding TransferDetails}" Classes="Muted" FontSize="12" TextAlignment="Center" />
                    <Button Content="Cancel installation" Command="{Binding CancelInstallationCommand}" Classes="SecondaryBtn" IsVisible="{Binding CanCancelInstallation}" HorizontalAlignment="Center" />
                    <Button Content="View downloads" Command="{Binding ShowDownloadsCommand}" Classes="SecondaryBtn" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="startupOverlay" Classes="StartupOverlay" Background="{DynamicResource ThemeBackgroundBrush}" IsVisible="{Binding IsStartupGreetingVisible}">
            <StackPanel x:Name="startupGreeting" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Classes="Eyebrow" Text="VORTEX LAUNCHER" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="{Binding StartupGreeting}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StartupUsername}" Foreground="{DynamicResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" />
                <TextBlock Text="Preparing your next adventure..." Classes="Muted" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
